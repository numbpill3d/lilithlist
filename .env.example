# Copy to your environment / systemd EnvironmentFile. Never commit real secrets.
PORT=4173
HOST=127.0.0.1
# TRUST_PROXY=1  # only when behind a proxy you control
LILITH_DB=data/lilithlist.db
# 32 bytes as 64 hex chars — generate with: openssl rand -hex 32
# LILITH_SECRET_KEY=
# First moderator key (>=16 chars) — REQUIRED in production (NODE_ENV=production)
# Generate with: openssl rand -base64 24
# MOD_BOOTSTRAP_KEY=
# LILITH_NODE_KEY=data/node_identity.json
# LILITH_PEERS=data/peers.json
# FEDERATION_INTERVAL_MS=300000
# LILITH_SEED=1  # opt-in seeding of fictional demo data (dev default on, prod default off)
# LILITH_ONION_URL=http://your-onion-address.onion  # enables Onion-Location header for Tor users
# NODE_ENV=production
