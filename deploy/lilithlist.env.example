# Production environment for LilithList. Copy to /etc/lilithlist.env, chmod 600,
# fill in the two secrets, then `systemctl enable --now lilithlist`.
# Generate secrets with: openssl rand -hex 32  /  openssl rand -base64 24
LILITH_SECRET_KEY=
MOD_BOOTSTRAP_KEY=
# Optional:
# LILITH_RESOURCES=/var/lib/lilithlist/resources.json
# LILITH_ONION_URL=http://your-onion-address.onion
# FEDERATION_INTERVAL_MS=300000
